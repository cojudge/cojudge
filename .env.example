VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_GOOGLE_WEB_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_DESKTOP_CLIENT_ID=your_desktop_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=your_desktop_oauth_client_secret
IS_DEMO_SITE=false
# Optional runner-image overrides (offline-friendly images with pre-installed
# `time`; see docker/*/Dockerfile for build instructions).
#COJUDGE_CPP_IMAGE=cojudge-debugger-cpp:latest
#COJUDGE_GO_IMAGE=cojudge-go:latest
#COJUDGE_RUST_IMAGE=cojudge-debugger-rust:latest
#COJUDGE_PHP_IMAGE=cojudge-php:latest
