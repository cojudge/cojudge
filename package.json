{
	"name": "cojudge",
	"private": true,
	"version": "0.3.11",
	"description": "Offline-first LeetCode-style code judge with Docker sandboxing. Solve Blind 75 & NeetCode 150 in 7 languages.",
	"keywords": [
		"leetcode",
		"algorithm",
		"coding-interview",
		"offline-first",
		"docker",
		"sveltekit",
		"code-judge",
		"blind-75",
		"neetcode"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cojudge/cojudge.git"
	},
	"homepage": "https://cojudge.cloud",
	"bugs": {
		"url": "https://github.com/cojudge/cojudge/issues"
	},
	"license": "MIT",
	"type": "module",
	"bin": {
		"cojudge": "./bin/cojudge"
	},
	"scripts": {
		"test": "vitest",
		"test:e2e": "playwright test",
		"dev": "vite dev",
		"build": "vite build",
		"desktop:build": "tauri build",
		"desktop:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"desktop:icon": "tauri icon src/lib/assets/favicon.svg",
		"desktop:prepare": "npm run build && node scripts/stage-desktop-backend.mjs && node scripts/prepare-desktop-node.mjs",
		"preview": "vite preview",
		"postinstall": "node -e \"const fs = require('fs'); const path = 'node_modules/@firebase/util/dist/postinstall.mjs'; if (fs.existsSync('node_modules/@firebase/util/dist') && !fs.existsSync(path)) fs.writeFileSync(path, 'export const getDefaultsFromPostinstall = () => undefined;');\"",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tauri-apps/cli": "2.11.4",
		"@types/dockerode": "^3.3.44",
		"@types/marked": "^5.0.2",
		"@types/turndown": "^5.0.6",
		"autoprefixer": "^10.4.21",
		"firebase": "^12.6.0",
		"marked": "^16.4.0",
		"monaco-editor": "^0.54.0",
		"monaco-vim": "^0.4.4",
		"postcss": "^8.5.6",
		"qrcode": "^1.5.4",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^5.9.2",
		"uuid": "^13.0.0",
		"vite": "^7.1.7",
		"vitest": "^1.1.5"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"dockerode": "^5.0.1",
		"tar-stream": "^3.1.7",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2"
	}
}
